# Copy to deploy/.env on the shop server and fill in. deploy/.env is never committed (secrets).
# Generate strong values with:  openssl rand -base64 36

# Database password (letters and digits only, so it is safe inside the connection URL)
POSTGRES_PASSWORD=change-me-long-random-letters-and-digits

# Signs login tokens. 48+ random characters. Changing it logs everyone out.
JWT_SECRET=change-me-48-plus-random-characters

# Cloudflare Zero Trust → Networks → Tunnels → your tunnel → the token shown in the install command
CLOUDFLARE_TUNNEL_TOKEN=paste-the-tunnel-token

# Daily backup hour, Cairo time (00–23)
BACKUP_HOUR=02

# rclone remote and folder for the daily cloud copy, e.g. gdrive:jeepcity-backups (empty = local only).
# Configure the remote once with: docker compose run --rm --entrypoint rclone backup config
RCLONE_REMOTE=
