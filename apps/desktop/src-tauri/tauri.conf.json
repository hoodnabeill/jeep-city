{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Jeep City",
  "version": "0.2.3",
  "identifier": "com.jeepcity.shop",
  "build": {
    "frontendDist": "../../client/dist",
    "devUrl": "http://localhost:5180",
    "beforeBuildCommand": "npm run build:app -w @jc/client",
    "beforeDevCommand": "npm run dev -w @jc/client"
  },
  "app": {
    "windows": [
      {
        "title": "Jeep City · نظام الورشة",
        "width": 1440,
        "height": 900,
        "minWidth": 1100,
        "minHeight": 700,
        "maximized": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "Jeep City – El Tantawy USA",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico"],
    "windows": {
      "nsis": { "languages": ["Arabic", "English"], "installMode": "perMachine" },
      "webviewInstallMode": { "type": "downloadBootstrapper" }
    }
  }
}
